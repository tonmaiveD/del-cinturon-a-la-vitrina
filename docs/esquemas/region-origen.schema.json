{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nombre": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": ["cuerpo-progenitor", "familia", "tipo-espectral", "meteoroide-observado"]
    },
    "clases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confianza": {
      "type": "string",
      "enum": ["alto", "medio", "especulativo"]
    },
    "justificacion": {
      "type": "string"
    },
    "fuentes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "meteoritos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "id",
    "nombre",
    "tipo",
    "clases",
    "confianza",
    "justificacion",
    "fuentes",
    "meteoritos"
  ],
  "additionalProperties": false
}
