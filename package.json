{
  "name": "del-cinturon-a-la-vitrina",
  "version": "1.0.0",
  "description": "Del cinturón a la vitrina: el viaje de los meteoritos desde su origen hasta la Tierra",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run auditoria && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=escritorio --project=movil",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "tsx pipeline/validate-data.ts",
    "schemas": "tsx pipeline/export-schemas.ts",
    "validacion:chelyabinsk": "tsx pipeline/validacion-chelyabinsk.ts",
    "datos:trayectoria": "tsx pipeline/trayectoria-chelyabinsk.ts",
    "datos": "npm run validacion:chelyabinsk && npm run datos:trayectoria",
    "datos:texturas": "tsx pipeline/texturas.ts",
    "e2e:rendimiento": "playwright test --project=rendimiento --workers=1",
    "cierre:video": "tsx pipeline/grabar-recorrido.ts",
    "datos:granvik-brown": "tsx pipeline/importar-granvik-brown.ts",
    "verificacion:cruzada": "tsx pipeline/verificacion-cruzada.ts",
    "datos:jpl-2008tc3": "tsx pipeline/importar-jpl-2008tc3.ts",
    "datos:pedigri": "npm run datos:granvik-brown && npm run datos:jpl-2008tc3 && npm run datos:catalogo",
    "datos:catalogo": "tsx pipeline/generar-catalogo.ts",
    "auditoria": "tsx pipeline/auditar.ts",
    "cierre:fase-2": "tsx pipeline/grabar-fase-2.ts",
    "datos:cneos:descargar": "tsx pipeline/cneos-descargar.ts",
    "datos:cneos:orbitas": "tsx pipeline/cneos-orbitas.ts",
    "datos:cneos": "npm run datos:cneos:descargar && npm run datos:cneos:orbitas",
    "reporte:cneos": "tsx pipeline/reporte-cneos.ts",
    "cierre:fase-3": "tsx pipeline/grabar-fase-3.ts",
    "datos:trayectorias": "tsx pipeline/trayectorias-pedigri.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true
}
